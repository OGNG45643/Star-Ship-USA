    void DisplayGrid() const {
        std::cout << "\n====================================================================\n";
        std::cout << "                 FALCON-CLASS ARMOR DIAGNOSTIC GRID                  \n";
        std::cout << "====================================================================\n";
        std::cout << std::left << std::setw(5) << "ID" << " | " << std::setw(30) << "Structural Block Zone" << " | " << std::setw(12) << "Integrity" << " | Status\n";
