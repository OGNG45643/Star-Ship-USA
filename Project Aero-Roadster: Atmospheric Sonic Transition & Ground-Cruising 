                      << std::left << std::setw(30) << shipBlocks[i].zoneName << " | " 
                      << std::right << std::setw(9) << std::fixed << std::setprecision(1) << shipBlocks[i].integrityPercentage << "%"
                      << " | " << (shipBlocks[i].isFullyHealed ? "[✓] NOMINAL" : "[⚠] HEALING...") << "\n";
        }
        std::cout << "====================================================================\n";
    }

public:
    InteractiveHullConsole() {
        shipBlocks.push_back({"Forward Nose Intake Scoop ", 100.0, true});
        shipBlocks.push_back({"Dual-Pilot Tandem Canopy ", 100.0, true});
        shipBlocks.push_back({"Port Detonator Wing Array ", 100.0, true});
        shipBlocks.push_back({"Starboard Detonator Wing  ", 100.0, true});
        shipBlocks.push_back({"Bussard Core Housing Vault ", 100.0, true});
        shipBlocks.push_back({"Main Superconducting Rings ", 100.0, true});
    }

    // Main run loop handling manual keyboard injection and auto-repair feedback
    void RunSimulationLoop() {
        int userChoice = -1;
        double damageInput = 0.0;

        while (true) {
            DisplayGrid();
            std::cout << "\n[TEST MATRIX INTERFACE] Enter a Block ID (0-5) to inject structural damage, or enter -1 to quit: ";
            std::cin >> userChoice;

            if (userChoice == -1) {
                std::cout << "[SYSTEM] Closing diagnostic terminal. Passive monitoring remains active.\n";
                break;
            }

            if (userChoice < 0 || userChoice >= static_cast<int>(shipBlocks.size())) {
                std::cout << "[ERROR] Invalid Block ID. Please query indices within the active chassis limit.\n";
                continue;
            }

            std::cout << "Enter damage percentage to inflict (1.0 to 100.0): ";
            std::cin >> damageInput;
            
            // Apply structural stress event
            shipBlocks[userChoice].integrityPercentage -= damageInput;
            if (shipBlocks[userChoice].integrityPercentage < 0.0) shipBlocks[userChoice].integrityPercentage = 0.0;
            shipBlocks[userChoice].isFullyHealed = false;

            std::cout << "\n[⚠ ALERT] Impact registered on block [" << userChoice << "]. Initiating automatic MMC healer response...\n";
            std::this_thread::sleep_for(std::chrono::milliseconds(1000));

            // Run the local self-healing logic cycle until it matches structural baseline targets
            while (!shipBlocks[userChoice].isFullyHealed) {
                shipBlocks[userChoice].integrityPercentage += REPAIR_RATE_PER_TICK;
                
                if (shipBlocks[userChoice].integrityPercentage >= 100.0) {
                    shipBlocks[userChoice].integrityPercentage = 100.0;
                    shipBlocks[userChoice].isFullyHealed = true;
                    std::cout << ">> [" << shipBlocks[userChoice].zoneName << "] molecular structure stitched: " << shipBlocks[userChoice].integrityPercentage << "% [✓ SECURE]\n";
                } else {
                    std::cout << ">> [" << shipBlocks[userChoice].zoneName << "] self-healing progress: " << shipBlocks[userChoice].integrityPercentage << "%\n";
                }
                
                std::this_thread::sleep_for(std::chrono::milliseconds(600)); // Simulating real-time reconstruction tick
            }
        }
    }
};

int main() {
    InteractiveHullConsole console;
    console.RunSimulationLoop();
    return 0;
}


