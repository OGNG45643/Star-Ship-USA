#include <iostream>
#include <string>
#include <algorithm>
#include <cmath>

// Structure to hold ground and air handling dimensions
struct RoadsterDimensions {
    const double flightWidthFeet = 35.0;
    const double groundWidthFeet = 8.5; // Wings retracted for road use
    const double chassisLengthFeet = 65.0;
};

// Component list specifically for the Terrestrial / Sound Barrier Module
class RoadsterComponents {
public:
    std::string barrierShield = "Aero-Thermal Break Barrier";
    std::string aperture = "Variable Nose Aperture";
    std::string drivePods = "Magnetic Wheel Pods";
    std::string groundDucts = "Low-Altitude Compression Ducts";
};

class AeroRoadsterController {
private:
    RoadsterDimensions dimensions;
    RoadsterComponents components;
    double currentSpeedMach;
    double batteryReserveGW;
    bool isGroundModeActive;
    bool wingsRetracted;

public:
    AeroRoadsterController() 
        : currentSpeedMach(3.5), batteryReserveGW(800.0), isGroundModeActive(false), wingsRetracted(false) {}

    // Simulates the intense deceleration and pressure of breaking the sound barrier downwards
    void ExecuteSonicBarrierTransition() {
        std::cout << "\n======================================================\n";
        std::cout << "[TRANSITION INITIALIZED] Approaching Sonic Barrier Boundary.\n";
        std::cout << "======================================================\n";

        if (batteryReserveGW < 300.0) {
            std::cout << "[CRITICAL ALERT] Insufficient power to sustain Aero-Thermal shields. Aborting transition.\n";
            return;
        }

        // Engage systems to handle the sound barrier drop
        batteryReserveGW -= 250.0;
        currentSpeedMach = 0.95; // Dropped below Mach 1 safely
        
        std::cout << "[SYSTEM ACTIVE] " << components.barrierShield << " handling structural resonance.\n";
        std::cout << "[SYSTEM ACTIVE] " << components.aperture << " adjusted to subsonic compression geometry.\n";
        std::cout << "[STATUS] Sound barrier cleared successfully. Current Velocity: Mach " << currentSpeedMach << "\n";
        std::cout << "[RESERVE] Power remaining: " << batteryReserveGW << " GW\n";
    }

    // Handles the transformation sequence from aircraft to terrestrial roadster cruise
    void DeployRoadsterGroundMode() {
        std::cout << "\n------------------------------------------------------\n";
        std::cout << "[TRANSFORMATION SECHEDULED] Converting to Ground Roadster Layout.\n";
        std::cout << "------------------------------------------------------\n";

        if (currentSpeedMach > 0.3) {
            std::cout << "[DEPLOYMENT HALTED] Airspeed too high for ground configurations. Slow vehicle further.\n";
            return;
        }

        wingsRetracted = true;
        isGroundModeActive = true;
        currentSpeedMach = 0.0; // Brought to hover/stop for ground engagement
        batteryReserveGW -= 50.0;

        std::cout << "[MECHANICAL] Retracting flight surfaces. Operating width narrowed to: " << dimensions.groundWidthFeet << " ft.\n";
        std::cout << "[MECHANICAL] Dedeploying " << components.drivePods << " underneath chassis.\n";
        std::cout << "[STATUS] Ground Mode fully engaged. Low-Altitude Ducts handling local stabilization.\n";
        std::cout << "[STATUS] Vehicle is ready to cruise terrestrial roads and park normally.\n";
        std::cout << "[RESERVE] Power remaining: " << batteryReserveGW << " GW\n";
    }

    // Simulate basic driving utility
    void TerrestrialRoadsterDrive(double targetSpeedMPH) {
        if (!isGroundModeActive) {
            std::cout << "[DRIVE ERROR] Cannot execute road cruise. Vehicle is still in flight configuration.\n";
            return;
        }

        if (targetSpeedMPH > 85.0) {
            std::cout << "[TRAFFIC WARNING] Speed throttled to legal highway boundaries.\n";
            targetSpeedMPH = 85.0;
        }

        batteryReserveGW -= 5.0; // Minimal power draws on wheels compared to thrusters
        std::cout << "[ROAD CRUISE] Driving smoothly via " << components.drivePods << " at " << targetSpeedMPH << " MPH.\n";
    }
};

int main() {
    AeroRoadsterController testShip;

    // Run full operational timeline simulation
    testShip.ExecuteSonicBarrierTransition();
    testShip.DeployRoadsterGroundMode();
    testShip.TerrestrialRoadsterDrive(65.0);

    return 0;
}


