import math

class PowerSystem:
    def __init__(self, max_capacity_gw: float = 1000.0, burst_cost_gw: float = 250.0):
        self.current_power_gw = 0.0
        self.max_capacity_gw = max_capacity_gw
        self.burst_cost_gw = burst_cost_gw

    def harvest_solar_energy(self, solar_flux: float, efficiency: float = 0.94) -> float:
        """Harvests energy via the photovoltaic skin and intake scoops."""
        collected = solar_flux * efficiency * 0.1
        self.current_power_gw = min(self.current_power_gw + collected, self.max_capacity_gw)
        return collected

    def trigger_reburst(self) -> bool:
        """Executes a power reburst for immediate speed or control maneuvers."""
        if self.current_power_gw < self.burst_cost_gw:
            print(f"[REBURST FAILED] Insufficient energy! Need {self.burst_cost_gw} GW, have {self.current_power_gw:.1f} GW.")
            return False
        
        self.current_power_gw -= self.burst_cost_gw
        print(f"[POWER REBURST ENGAGED] Released {self.burst_cost_gw} GW. Remaining: {self.current_power_gw:.1f} GW.")
        return True

    def get_power_level(self) -> float:
        return self.current_power_gw


