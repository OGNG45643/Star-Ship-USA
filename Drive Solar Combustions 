#include <iostream>
#include <algorithm>
#include <string>

class ThermalVentilator {
private:
    double currentTempKelvin;
    double maxSafeTempKelvin;
    double coolingEfficiency;

public:
    ThermalVentilator(double maxTemp = 500.0, double efficiency = 0.90)
        : currentTempKelvin(300.0), maxSafeTempKelvin(maxTemp), coolingEfficiency(efficiency) {}

    void AddThermalLoad(double heatInput) {
        currentTempKelvin += heatInput;
        DissipateHeat();
    }

    void DissipateHeat() {
        // Automatically radiate ambient heat into the vacuum of space
        double dissipated = (currentTempKelvin - 300.0) * coolingEfficiency * 0.15;
        currentTempKelvin = std::max(300.0, currentTempKelvin - dissipated);
    }

    bool IsOverheating() const {
        return currentTempKelvin >= maxSafeTempKelvin;
    }

    double GetTemperature() const { return currentTempKelvin; }
};

class EnergyCell {
private:
    double storedEnergyGJ;
    double maxCapacityGJ;

public:
    EnergyCell(double capacity = 1000.0) : storedEnergyGJ(0.0), maxCapacityGJ(capacity) {}

    void ChargeCell(double amountGJ) {
        storedEnergyGJ = std::min(storedEnergyGJ + amountGJ, maxCapacityGJ);
        std::cout << "[ENERGY CELL] Charged + " << amountGJ << " GJ. Total: " << storedEnergyGJ << " / " << maxCapacityGJ << " GJ\n";
    }

    bool DischargeBeam(double amountGJ) {
        if (storedEnergyGJ < amountGJ) {
            std::cout << "[EMITTER FAILED] Insufficient energy stored for beam discharge!\n";
            return false;
        }
        storedEnergyGJ -= amountGJ;
        std::cout << "[BEAM EMITTER] High-power beam discharged (" << amountGJ << " GJ). Remaining: " << storedEnergyGJ << " GJ\n";
        return true;
    }

    double GetStoredEnergy() const { return storedEnergyGJ; }
};

class StarshipSystemManager {
private:
    ThermalVentilator ventilator;
    EnergyCell forwardBeamCell;

public:
    StarshipSystemManager() : ventilator(450.0, 0.95), forwardBeamCell(1000.0) {}

    void RunSystemCycle(double incomingHeat, double chargeAmount, double dischargeAmount) {
        std::cout << "\n--- Executing System Cycle ---\n";
        
        // Feed energy into cell
        forwardBeamCell.ChargeCell(chargeAmount);

        // Add thermal load from movement/charging
        ventilator.AddThermalLoad(incomingHeat);
        std::cout << "[VENTILATOR] Current Core Temperature: " << ventilator.GetTemperature() << " K\n";

        if (ventilator.IsOverheating()) {
            std::cout << "[WARNING] Thermal threshold reached! Ventilator operating at maximum capacity.\n";
        } else {
            std::cout << "[STATUS] Thermal levels nominal.\n";
        }

        // Fire forward beam
        forwardBeamCell.DischargeBeam(dischargeAmount);
    }
};

int main() {
    StarshipSystemManager falconSystems;

    // Simulate standard flight and beam firing cycle
    falconSystems.RunSystemCycle(80.0, 300.0, 150.0);
    falconSystems.RunSystemCycle(120.0, 400.0, 250.0);

    return 0;
}


