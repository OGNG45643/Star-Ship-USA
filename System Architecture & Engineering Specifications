import time

class HydroSanitaryEjectorSystem:
    def __init__(self):
        self.graywater_liters = 0.0  # From shower and sink
        self.blackwater_kg = 0.0     # From toilet
        self.ventral_door_open = False
        self.shield_size_feet = "4x4 ft"

    def use_shower(self, duration_minutes: float):
        """Simulates taking a shower, capturing all runoff water."""
        water_used = duration_minutes * 5.0  # 5 liters per minute
        self.graywater_liters += water_used
        print(f"[SHOWER ACTIVE] Running for {duration_minutes} min. Collected {water_used}L of graywater.")
        print(f"[SUMP TANK] Total Graywater Stored: {self.graywater_liters:.1f} L")

    def add_sanitary_waste(self, amount_kg: float):
        """Adds solid/liquid waste from the vacuum toilet."""
        self.blackwater_kg += amount_kg
        print(f"[SANITARY UNIT] Waste routed to holding sump. Total Blackwater: {self.blackwater_kg:.1f} kg")

    def execute_stabilized_flush(self):
        """Executes the 4x4 ventral hatch flush with stabilization and radiation flash-burn protection."""
        print("\n--- INITIATING STABILIZED VETRAL EJECTION CYCLE ---")
        
        if self.graywater_liters == 0.0 and self.blackwater_kg == 0.0:
            print("[FLUSH ABORTED] Holding tanks are empty. Nothing to eject.")
            return

        print(f"[*] Opening {self.shield_size_feet} bottom ventral shield door...")
        self.ventral_door_open = True
        time.sleep(0.3)

        print("[*] Engaging Inertial Stabilization Counter-Thrusters... (Keeping ship rock steady)")
        print("[*] Activating Radiation & Oxygen Flash-Burn Shield at nozzle edge...")
        print("    -> Plasma arc online: Blocking cosmic radiation ingress and oxygen backflow toxicity.")

        # Eject contents
        dumped_water = self.graywater_liters
        dumped_waste = self.blackwater_kg
        self.graywater_liters = 0.0
        self.blackwater_kg = 0.0

        print(f"[SUCCESS] Ejected {dumped_water:.1f}L graywater and {dumped_waste:.1f}kg blackwater into deep space.")
        
        print("[*] Firing Flash-Burn sterilization pulse...")
        time.sleep(0.2)

        print(f"[*] Closing {self.shield_size_feet} bottom shield door instantly and sealing airlock.")
        self.ventral_door_open = False
        print("[SYSTEM READY] Hull integrity 100%. Cabin atmosphere and radiation levels nominal.")


# --- Execution Simulation ---
if __name__ == "__main__":
    print("=== FALCON-CLASS HYDRO-SANITARY EJECTION SYSTEM ONLINE ===")
    
    system = HydroSanitaryEjectorSystem()

    # 1. Crew takes a 4-minute shower and uses the sink
    system.use_shower(duration_minutes=4.0)

    # 2. Use the toilet
    system.add_sanitary_waste(1.5)

    print()

    # 3. Flush everything out safely using the 4x4 hatch and stabilization
    system.execute_stabilized_flush()


