class FalconInteriorUtilities:
    def __init__(self):
        self.sink_water_active = True
        self.steam_deck_humidity_pct = 45.0
        self.toilet_vacuum_seal_engaged = True
        self.plasma_outlets = {
            "Bridge": True,
            "Galley": True,
            "Engineering": True,
            "Quarters": True
        }

    def use_sink_and_steam_decks(self, liters_requested: float):
        """Dispenses clean water at the sink and regulates edge steam decks for hydration."""
        if self.sink_water_active:
            print(f"[GALLEY SINK] Dispensing {liters_requested}L of pure, earth-grade water from life support loop.")
            self.steam_deck_humidity_pct = min(60.0, self.steam_deck_humidity_pct + 2.0)
            print(f"[STEAM DECKS] Feather-CO2 edge lines active. Cabin humidity stabilized at {self.steam_deck_humidity_pct}%.")
        else:
            print("[SINK ERROR] Water line pressure offline.")

    def flush_sanitary_unit(self, waste_type: str) -> bool:
        """Executes a secure vacuum flush into space with strict interlocks."""
        if not self.toilet_vacuum_seal_engaged:
            print("[SAFETY ALERT] Vacuum seal disengaged! Flush aborted to prevent hull depressurization.")
            return False
        
        print(f"[SANITARY UNIT] Security vacuums active. Sanitizing {waste_type} via UV plasma arc...")
        print(f"[SANITARY UNIT] Waste safely vented into deep space. Airlock re-pressurized.")
        return True

    def check_plasma_outlets(self):
        """Monitors the 4 plasma-powered electrical outlets across the ship."""
        print("\n--- Plasma-Powered Outlets Status ---")
        for zone, active in self.plasma_outlets.items():
            status = "ONLINE (Stable 120V Plasma Feed)" if active else "OFFLINE"
            print(f"  * {zone} Outlet: {status}")


