class FalconLifeSupportSystem:
    def __init__(self):
        self.oxygen_bar = 0.21          # Safe standard atmospheric partial pressure
        self.temperature_f = 72.0       # Comfortable room temp
        self.water_tank_liters = 500.0  # Lifetime reserve baseline
        self.coal_dust_kg = 150.0       # Carbon catalyst reserve
        self.antigravity_field_g = 1.0  # Earth-norm gravity simulation

    def set_climate(self, target_temp: float):
        """Adjusts cabin temperature safely between 60.0 and 100.0 °F."""
        if target_temp < 60.0 or target_temp > 100.0:
            print(f"[SAFETY INTERLOCK] Rejected {target_temp}°F. Must be between 60.0°F and 100.0°F to prevent injury.")
            return False
        self.temperature_f = target_temp
        print(f"[CLIMATE] Temperature successfully adjusted to {self.temperature_f}°F.")
        return True

    def process_oxygen_cycle(self):
        """Simulates lifelong $O_2$ production using water tank, coal dust, and methane catalysis."""
        if self.water_tank_liters > 0.1 and self.coal_dust_kg > 0.1:
            self.water_tank_liters -= 0.05  # Micro-consumption closed loop
            self.coal_dust_kg -= 0.01
            print(f"[OXYGEN GENERATOR] Plasma-solar electrolysis active. O2 Pressure: {self.oxygen_bar} bar.")
            print(f"                   Consumables Left -> Water: {self.water_tank_liters:.1f}L | Coal Dust: {self.coal_dust_kg:.1f}kg")
        else:
            print("[CRITICAL WARNING] Consumables depleted!")

    def engage_antigravity(self, target_g: float):
        """Smoothly adjusts anti-gravity field to neutralize inertia during planetary stops."""
        self.antigravity_field_g = max(0.0, min(target_g, 1.0))
        print(f"[ANTI-GRAVITY] Field stabilizer active. Inertial compensation set to: {self.antigravity_field_g} G-Force.")


