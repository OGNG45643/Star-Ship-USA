        std::cout << "--------------------------------------------------------------------\n";

        for (auto& line : plumbingHeaters) {
            if (line.currentTemperatureF < line.TARGET_LUKEWARM_F) {
                line.burnersIgnited = true;
                
                // Gradually heat up the line to simulate thermal lag over the coal/sand blocks
                double ambientHeatInjection = line.TARGET_LUKEWARM_F - line.currentTemperatureF;
                line.currentTemperatureF += ambientHeatInjection; // Instant stabilization for demonstration
                
                std::cout << " >> [BURNER ENGAGED] " << line.lineDestination << " warmed to target parameters.\n";
            } else {
                line.burnersIgnited = false;
            }
        }
        
        std::cout << "--------------------------------------------------------------------\n";
        std::cout << "[SUCCESS] Burners modulated. Closed-loop water lines holding at steady Luke-Warm baseline.\n";
        std::cout << "====================================================================\n\n";
    }
