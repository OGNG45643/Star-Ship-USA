import time
import random

class LiquidDataContainer:
    """Manages high-density optical liquid data storage tanks and transfer tubing."""
    def __init__(self, capacity_liters: float = 5000.0):
        self.capacity_liters = capacity_liters
        self.current_volume_liters = 0.0
        self.data_density_pb_per_liter = 12.5  # Petabytes per liter of optical fluid
        self.tubing_pressure_psi = 14.7

    def pump_liquid_data(self, volume_liters: float, action: str = "store") -> bool:
        """Pumps liquid data through reinforced mag-tubes."""
        if action == "store":
            if self.current_volume_liters + volume_liters > self.capacity_liters:
                print("[TUBE ERROR] Liquid data container overflow prevented!")
                return False
            self.current_volume_liters += volume_liters
            self.tubing_pressure_psi += (volume_liters * 0.05)
            print(f"[LIQUID TUBE PUMP] Injected {volume_liters}L of data fluid. Tank: {self.current_volume_liters}/{self.capacity_liters} L")
        elif action:
            if self.current_volume_liters - volume_liters < 0:
                print("[TUBE ERROR] Cannot drain more liquid data than available!")
                return False
            self.current_volume_liters -= volume_liters
            self.tubing_pressure_psi = max(14.7, self.tubing_pressure_psi - (volume_liters * 0.05))
            print(f"[LIQUID TUBE PUMP] Extracted {volume_liters}L of data fluid. Tank: {self.current_volume_liters}/{self.capacity_liters} L")
        return True

    def get_total_petabytes(self) -> float:
        return self.current_volume_liters * self.data_density_pb_per_liter


