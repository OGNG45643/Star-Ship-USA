import time
import psutil
import keyboard

class FalconCompressionAndTerminal:
    def __init__(self):
        self.copv_pressure_psi = 10000.0
        self.active_nozzles = 12
        self.radiation_shield_active = True
        self.suction_safeguard_locked = True
        self.running = True

    def fire_compression_brakes(self, target_nozzles: list, burst_duration_sec: float):
        """Fires specified ports out of the 12-hole air compression braking matrix."""
        print(f"\n[AIR COMPRESSION BRAKES] Engaging nozzles: {target_nozzles}")
        
        pressure_drop = len(target_nozzles) * burst_duration_sec * 45.0
        if self.copv_pressure_psi - pressure_drop < 0:
            print("[WARNING] COPV Pressure critically low! Braking maneuver restricted.")
            return False

        self.copv_pressure_psi -= pressure_drop
        print(f"[*] Venting 10,000 PSI air through De Laval nozzles.")
        print(f"[*] Kinetic stabilization active. Remaining Tank Pressure: {self.copv_pressure_psi:.1f} PSI")
        return True

    def monitor_radiation_and_suction(self):
        """Monitors space radiation flux and prevents destructive vacuum suction backflow."""
        print("\n--- SHIELDING & SUCTION STATUS ---")
        print(f"  * Radiation Deflector Grid : {'ONLINE (Mag-Shield Active)' if self.radiation_shield_active else 'OFFLINE'}")
        print(f"  * Suction Safeguard Valves : {'LOCKED (Overpressure Protected)' if self.suction_safeguard_locked else 'OPEN'}")
        print(f"  * COPV Tank Reserves       : {self.copv_pressure_psi} PSI / 10,000 PSI")

    def anti_app_terminate(self, app_name: str):
        """Terminates runaway background tasks or local applications."""
        count = 0
        print(f"\n[ANTI-APP] Scanning processes for target: '{app_name}'...")
        for proc in psutil.process_iter(['pid', 'name']):
            try:
                if proc.info['name'] and app_name.lower() in proc.info['name'].lower():
                    proc.kill()
                    print(f"  -> Terminated: {proc.info['name']} (PID: {proc.info['pid']})")
                    count += 1
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass
        print(f"[ANTI-APP RESULT] Successfully cleared {count} instance(s).")

    def run_control_loop(self):
        """Main interface loop combining starship controls and process management."""
        print("=== FALCON-CLASS 12-HOLE AIR COMPRESSION & TERMINAL CORE ===")
        
        while self.running:
            print("\n--------------------------------------------------")
            print("1. Fire 12-Hole Air Compression Brakes")
            print("2. Check Radiation & Suction Safeguards")
            print("3. Run Anti-App Process Killer")
            print("4. Exit Terminal")
            
            choice = input("\nSelect system command [1-4]: ").strip()
            
            if choice == '1':
                noz_input = input("Enter nozzle numbers to fire (1-12, comma-separated e.g., 1,2,12): ")
                try:
                    nozzles = [int(n.strip()) for n in noz_input.split(',')]
                    self.fire_compression_brakes(nozzles, burst_duration_sec=1.5)
                except ValueError:
                    print("[ERROR] Invalid nozzle format.")
            elif choice == '2':
                self.monitor_radiation_and_suction()
            elif choice == '3':
                target = input("Enter application/process name to wipe: ").strip()
                if target:
                    self.anti_app_terminate(target)
            elif choice == '4':
                print("Shutting down terminal sequence. Safe travels, Captain.")
                self.running = False
                break
            else:
                print("Invalid input. Please select a valid number.")

if __name__ == "__main__":
    system = FalconCompressionAndTerminal()
    system.run_control_loop()




