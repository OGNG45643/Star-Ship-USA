class FalconBrakingSystem:
    def __init__(self):
        self.copv_pressure_psi = 10000.0
        self.anti_flex_valves_open = False
        self.nozzle_layout = {
            "Top": 4,
            "Bottom": 4,
            "Sides": {"Port": 2, "Starboard": 2}
        }

    def engage_emergency_brakes(self, vector: str, use_plasma_boost: bool = True):
        """Fires specific nozzle clusters with anti-flex vent protection and plasma exhaust braking."""
        print(f"\n[BRAKING INITIATED] Emergency stop vector: {vector.upper()}")
        
        if vector not in ["top", "bottom", "sides", "all"]:
            print("[ERROR] Invalid braking vector specified.")
            return

        # Anti-flex vent check
        self.anti_flex_valves_open = True
        print("[ANTI-FLEX VENTS] Dynamic pressure relief louvers opened to protect titanium frame.")

        boost_text = ""
        air_cost = 200.0

        if use_plasma_boost:
            air_cost += 150.0
            boost_text = " + [PLASMA BOOST EXHAUST] Muffler-style reverse plasma thrust active!"

        if self.copv_pressure_psi - air_cost < 0:
            print("[CRITICAL WARNING] COPV Tank pressure depleted! Braking power restricted.")
            return

        self.copv_pressure_psi -= air_cost
        print(f"[*] Venting compressed air through 12-hole matrix ({vector}).{boost_text}")
        print(f"[*] Momentum neutralized safely. Remaining Tank Pressure: {self.copv_pressure_psi:.1f} PSI")

        # Close vents post-braking
        self.anti_flex_valves_open = False
        print("[ANTI-FLEX VENTS] Pressure normalized. Vents locked.")

